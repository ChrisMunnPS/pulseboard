# Created for you by ./setup.sh (or setup.ps1). Edit only if you need to.
DB_PASSWORD=change-me
JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-please
# true = load demo devices and alerts on first start
SEED_DEMO=true
WEB_PORT=3000
API_PORT=4000
# Comma-separated list of allowed web origins, or * for any
CORS_ORIGIN=*
# Set to true ONLY when Pulseboard sits behind a reverse proxy you control (so sign-in limits see the real client address)
TRUST_PROXY=false
# Who can reach Pulseboard. 127.0.0.1 = only this computer (safest). Use 0.0.0.0 to allow other computers,
# and put HTTPS (a reverse proxy) in front of it first.
BIND_ADDRESS=127.0.0.1
# How often (seconds) monitored devices are checked, 10 to 300
POLL_SECONDS=30
